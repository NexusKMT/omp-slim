{
	"useTabs": true,
	"tabWidth": 3,
	"printWidth": 120,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "avoid",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": [
		"packages/natives/native/**/*",
		"**/vendor/**/*",
		"**/node_modules/**/*",
		"**/test-sessions.ts",
		"packages/coding-agent/src/modes/rpc/wire/rpc-wire.generated.ts",
		".worktrees/**/*",
		".wt/**/*"
	]
}
